#!/usr/bin/env bash
set -euo pipefail

echo "[git-history] Regenerating git-history in background..."
REPO_ROOT="$(git rev-parse --show-toplevel)"
LOG_FILE="/tmp/llm-market-bench-git-history.log"
LOCK_FILE="/tmp/llm-market-bench-git-history.lock"
nohup flock -n "$LOCK_FILE" "$REPO_ROOT/apps/engine/.venv/bin/python3" "$REPO_ROOT/apps/engine/export_git_history.py" </dev/null > "$LOG_FILE" 2>&1 &
