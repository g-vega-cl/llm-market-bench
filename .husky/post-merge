# Re-index QMD if wiki/ was updated by the merge
if [ -d "wiki" ] && git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD | grep -qE '^(wiki|raw)/'; then
  echo "[wiki] Wiki or raw/ changed by merge — re-indexing QMD..."
  export NVM_DIR="$HOME/.nvm" && . "$NVM_DIR/nvm.sh" && nvm use 24 && qmd update && qmd embed
fi

# Regenerate git-history markdown files and re-index QMD git-history collection
echo "[git-history] Regenerating git-history after merge..."
REPO_ROOT="$(git rev-parse --show-toplevel)"
"$REPO_ROOT/apps/engine/.venv/bin/python3" "$REPO_ROOT/apps/engine/export_git_history.py" || echo "[git-history] WARNING: Git history sync failed"
