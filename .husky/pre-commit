#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Auto-document code changes in the wiki (BLOCKING)
"$REPO_ROOT/scripts/auto-wiki.sh"

# Lint Python (engine)
( cd "$REPO_ROOT/apps/engine" && source .venv/bin/activate && ruff check )

# Lint TypeScript (web + packages)
pnpm biome check --no-errors-on-unmatched apps/web packages/database packages/ui-design-system

# Run tests with coverage enforcement (70% engine, 40% web)
echo "[coverage] Running engine tests with coverage..."
( cd "$REPO_ROOT/apps/engine" && source .venv/bin/activate && python3 -m pytest --cov=. --cov-config=.coveragerc --cov-fail-under=70 )

echo "[coverage] Running web tests with coverage..."
( cd "$REPO_ROOT/apps/web" && pnpm test -- --coverage )

# Build + type-check (BLOCKING — must pass)
pnpm build:web

# Run wiki lint and re-index QMD when wiki/ files change
if git diff --cached --name-only | grep -qE '^(wiki|raw)/'; then
  echo "[wiki] Running structural lint..."
  "$REPO_ROOT/apps/engine/.venv/bin/python3" "$REPO_ROOT/apps/engine/wiki_lint.py" || exit 1
  echo "[wiki] Re-indexing QMD..."
  export NVM_DIR="$HOME/.nvm" && . "$NVM_DIR/nvm.sh" && nvm use 24 && qmd update && qmd embed
fi
