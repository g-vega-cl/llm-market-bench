{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "market-bench-cron-dispatcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "12 13,14 * * MON-FRI",
      "35 13-16 * * MON-FRI",
      "30 19,20 * * MON-FRI",
      "0 21,22 * * MON-FRI"
    ]
  }
}
