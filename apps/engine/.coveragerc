[run]
source = .
omit =
    auto_wiki.py
    wiki_lint.py
    wiki_lint_llm.py
    scripts/*
    tests/*
    */__pycache__/*
    .venv/*

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if TYPE_CHECKING:
