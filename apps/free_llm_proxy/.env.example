# Free LLM Proxy Configuration
PORT=8086
HOST=127.0.0.1

# Master API Key required from clients (Authorization: Bearer <FREE_PROXY_MASTER_KEY>)
FREE_PROXY_MASTER_KEY=sk-free-proxy-secret-key-12345

# Provider API Keys (leave blank for unconfigured providers; the proxy automatically activates whichever keys are present)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY_FREE=...
OPENROUTER_API_KEY=sk-or-v1-...
NVIDIA_API_KEY=

# OpenCode Go (paid subscription; only used by auto-go / auto-strata-go / strata-auto-go or explicit opencode-go/<model>)
OPENCODE_GO_API_KEY=

# Local Strata Settings (optional; defaults to localhost:8080)
STRATA_BASE_URL=http://localhost:8080/v1
ENABLE_STRATA=true

# Database & Cooldown settings
SQLITE_DB_PATH=data/free_llm_proxy.db
DEFAULT_COOLDOWN_SECONDS=60
MAX_FAILOVER_RETRIES=4

# Output budget: reasoning tokens are billed inside max_tokens, so this is the
# real thinking cap. Providers can override it via "max_output_tokens" in
# providers.json; this value applies only to providers that declare none.
CLOUD_MAX_OUTPUT_TOKENS=32768

# Wall-clock cap per non-Strata attempt (also the httpx read window). Keep it
# below the tightest caller's patience so failover fits in their window: the live
# trader waits 200s, engine instructor clients 180s. Streaming is not bounded.
CLOUD_REQUEST_TIMEOUT_SECONDS=90.0

# Per-attempt wall-clock caps under CLOUD_REQUEST_TIMEOUT_SECONDS. A free segment
# that runs longer than the caller's own patience is a wasted retry: engine auto-go
# callers give up at 180s, and a 6-provider pass at 90s each took 272-721s.
# Non-streaming only; streaming keeps its previous (unbounded) patience.
FREE_ATTEMPT_TIMEOUT_SECONDS=45.0
PAID_ATTEMPT_TIMEOUT_SECONDS=45.0
# Whole free-segment budget. Once spent, remaining free candidates are skipped
# with a logged reason and the *-go paid last resort is dispatched. Re-checked
# before every dispatch (including cascade retries). 0 disables.
FREE_PASS_DEADLINE_SECONDS=120.0

# Whole metered-segment budget, on top of the free one. Non-streaming *-go
# requests therefore end by FREE + PAID (165s by default), inside the engine's
# 180s caller timeout. Only one metered model is dispatched per request.
PAID_PASS_DEADLINE_SECONDS=45.0

# The paid tier is kept out of free aliases by routing (the auto_aliases
# allowlist in providers.json), not by a timeout flag. There is nothing to set.

# Optional thinking floor for *-go aliases (low|medium|high). Empty = provider
# default (Gemini 3 is dynamic/high). Only sent to providers that declare
# "thinking_params" support in providers.json.
AUTO_GO_DEFAULT_REASONING_EFFORT=

# Connector identity (metrics are per-connector; set explicitly in compose)
CONNECTOR_ID=workstation

# Log-only 401 spike detection (0 disables)
SECURITY_ALERT_401_THRESHOLD=20
SECURITY_ALERT_WINDOW_SECONDS=300
