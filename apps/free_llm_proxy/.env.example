# Free LLM Proxy Configuration
PORT=8086
HOST=127.0.0.1

# Master API Key required from clients (Authorization: Bearer <FREE_PROXY_MASTER_KEY>)
FREE_PROXY_MASTER_KEY=sk-free-proxy-secret-key-12345

# Provider API Keys (leave blank for unconfigured providers; the proxy automatically activates whichever keys are present)
GROQ_API_KEY=gsk_...
GEMINI_API_KEY_FREE=...
OPENROUTER_API_KEY=sk-or-v1-...
NVIDIA_API_KEY=

# OpenCode Go (paid subscription; only used by auto-go / auto-strata-go / strata-auto-go or explicit opencode-go/<model>)
OPENCODE_GO_API_KEY=

# Local Strata Settings (optional; defaults to localhost:8080)
STRATA_BASE_URL=http://localhost:8080/v1
ENABLE_STRATA=true

# Database & Cooldown settings
SQLITE_DB_PATH=data/free_llm_proxy.db
DEFAULT_COOLDOWN_SECONDS=60
MAX_FAILOVER_RETRIES=4

# Connector identity (metrics are per-connector; set explicitly in compose)
CONNECTOR_ID=workstation

# Log-only 401 spike detection (0 disables)
SECURITY_ALERT_401_THRESHOLD=20
SECURITY_ALERT_WINDOW_SECONDS=300
