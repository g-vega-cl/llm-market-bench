{
  "providers": {
    "groq": {
      "name": "Groq",
      "base_url": "https://api.groq.com/openai/v1",
      "env_key": "GROQ_API_KEY",
      "tier": 1,
      "requires_auth": true,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "*gpt-oss-120b*",
        "*qwen3.8-27b*",
        "*-20b*",
        "*allam-2-7b*"
      ]
    },
    "gemini": {
      "name": "Google Gemini",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
      "env_key": "GEMINI_API_KEY_FREE",
      "tier": 1,
      "requires_auth": true,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "gemini-flash-latest",
        "*gemini-3.8-flash*",
        "*gemini-3.7-flash*",
        "*gemini-3.6-flash*",
        "*gemini-3.5-flash*",
        "*gemini-3.*flash*",
        "*flash-latest*"
      ]
    },
    "kilo": {
      "name": "Kilo Code",
      "base_url": "https://api.kilo.ai/api/gateway",
      "env_key": null,
      "tier": 1,
      "requires_auth": false,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "kilo-auto/free",
        "*:free",
        "*-free"
      ]
    },
    "openrouter": {
      "name": "OpenRouter",
      "base_url": "https://openrouter.ai/api/v1",
      "env_key": "OPENROUTER_API_KEY",
      "tier": 2,
      "requires_auth": true,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "openrouter/free",
        "*ultra*",
        "*super-vl*",
        "*lightning*",
        "*:free"
      ],
      "extra_headers": {
        "HTTP-Referer": "https://llm.clvg.uk",
        "X-Title": "Pi / Free LLM Proxy"
      }
    },
    "ovhcloud": {
      "name": "OVHcloud",
      "base_url": "https://oai.endpoints.kepler.ai.cloud.ovh.net/v1",
      "env_key": null,
      "tier": 2,
      "requires_auth": false,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "gpt-oss-120b",
        "gpt-oss-20b",
        "Meta-Llama-3_3-70B-Instruct",
        "Qwen3.8-27B"
      ]
    },
    "nvidia": {
      "name": "NVIDIA NIM",
      "base_url": "https://integrate.api.nvidia.com/v1",
      "env_key": "NVIDIA_API_KEY",
      "tier": 2,
      "requires_auth": true,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "*nemotron-3.5-super-vl-120b*",
        "*nemotron-3-ultra-550b*",
        "*mistral-large*",
        "*minimax-m3.1-flash*",
        "*nemotron-3.5-lightning*",
        "*diffusiongemma*",
        "*llama-3.2-90b-vision*"
      ]
    },
    "strata": {
      "name": "Strata (Local)",
      "base_url": "http://localhost:8080/v1",
      "env_key": null,
      "tier": 1,
      "requires_auth": false,
      "enabled_in_auto": false,
      "models_endpoint": "/models",
      "preferred_patterns": [
        "*"
      ]
    },
    "opencode-go": {
      "name": "OpenCode Go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "env_key": "OPENCODE_GO_API_KEY",
      "tier": 3,
      "billing": "paid",
      "auto_aliases": ["auto-go", "auto-strata-go"],
      "requires_auth": true,
      "models_endpoint": "/models",
      "extra_headers": {
        "User-Agent": "free-llm-proxy/1.0 (llm.clvg.uk)"
      },
      "preferred_patterns": [
        "*flash*",
        "*kimi*k3*",
        "*deepseek*",
        "*glm*",
        "*qwen*",
        "*"
      ]
    }
  },
  "virtual_aliases": {
    "free-auto": ["*120b*", "*70b*", "*flash*", "*27b*", "*"],
    "strata-auto": ["*120b*", "*70b*", "*flash*", "*27b*", "*"],
    "auto-strata": ["*120b*", "*70b*", "*flash*", "*27b*", "*"],
    "auto-go": ["*120b*", "*70b*", "*flash*", "*27b*", "*"],
    "auto-strata-go": ["*120b*", "*70b*", "*flash*", "*27b*", "*"],
    "strata": ["*"],
    "free-fast": ["*-20b*", "*:20b*", "*8b*", "*flash-lite*", "*7b*", "*"],
    "free-reasoning": ["*r1*", "*reasoning*", "*flint*", "*beam*", "*"]
  }
}
