{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/apps/web/**",
            "**/packages/database/**",
            "**/packages/ui-design-system/**",
            "!**/dist",
            "!**/.netlify",
            "!**/node_modules",
            "!**/.vinxi",
            "!**/routeTree.gen.ts",
            "!**/app.css"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "a11y": {
                "noStaticElementInteractions": "warn",
                "useKeyWithClickEvents": "warn",
                "noLabelWithoutControl": "warn"
            },
            "complexity": {
                "noExcessiveCognitiveComplexity": "warn"
            },
            "suspicious": {
                "noExplicitAny": "warn",
                "noArrayIndexKey": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn"
            }
        }
    },
    "overrides": [
        {
            "includes": ["**/packages/database/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/CorrelationHeatmap.tsx"],
            "linter": {
                "rules": {
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useKeyWithClickEvents": "off"
                    },
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off"
                    },
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/routes/**", "**/Login.tsx", "**/signup.tsx"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/lib/queries.ts", "**/lib/query-keys.ts"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/PerformanceChart.tsx",
                "**/PortfolioComparisonChart.tsx",
                "**/PositionsTable.tsx",
                "**/TradesTable.tsx",
                "**/UncorrelatedPairs.tsx",
                "**/FutureCatalysts.tsx",
                "**/MarketStatusHero.tsx",
                "**/HumanFriendlyPrompt.tsx",
                "**/HumanFriendlyResponse.tsx",
                "**/ReasoningPage.tsx",
                "**/MemoryCard.tsx",
                "**/MarketOverviewPage.tsx",
                "**/MemoryFlow.tsx",
                "**/ConceptMap.tsx",
                "**/EventChainPage.tsx",
                "**/fetch-portfolios.ts",
                "**/FormattedContent.tsx",
                "**/DataCard.tsx",
                "**/AgentInsights.tsx"
            ],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off"
                    },
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useKeyWithClickEvents": "off"
                    },
                    "style": {
                        "noNonNullAssertion": "off"
                    },
                    "suspicious": {
                        "noExplicitAny": "off",
                        "noArrayIndexKey": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/TradeActivity.tsx"],
            "linter": {
                "rules": {
                    "complexity": {
                        "noExcessiveCognitiveComplexity": "off"
                    },
                    "a11y": {
                        "noStaticElementInteractions": "off",
                        "useKeyWithClickEvents": "off",
                        "useSemanticElements": "off"
                    },
                    "suspicious": {
                        "noExplicitAny": "off",
                        "noArrayIndexKey": "off"
                    }
                }
            }
        },
        {
            "includes": [
                "**/MarketUpdates.tsx",
                "**/PortfolioDetailPage.tsx",
                "**/PortfoliosPage.tsx",
                "**/TodayPage.tsx",
                "**/NewsletterFeed.tsx",
                "**/portfolios/queries/options.ts",
                "**/CauseAndEffectCard.tsx",
                "**/CauseAndEffectList.tsx",
                "**/CauseAndEffectPage.tsx",
                "**/MemoriesPage.tsx",
                "**/AuditsPage.tsx",
                "**/fetch-audits.ts"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/ThoughtProcessFlow.tsx", "**/MemoryCard.tsx"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noArrayIndexKey": "off"
                    }
                }
            }
        },
        {
            "includes": ["**/*.test.ts", "**/*.test.tsx"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noExplicitAny": "off"
                    }
                }
            }
        }
    ],
    "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
