{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**/apps/web/**",
            "**/packages/database/**",
            "**/packages/ui-design-system/**",
            "!**/dist",
            "!**/.netlify",
            "!**/node_modules",
            "!**/.vinxi"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always",
            "bracketSpacing": true
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "complexity": {
                "noExcessiveCognitiveComplexity": "warn"
            },
            "style": {
                "noNonNullAssertion": "warn"
            }
        }
    },
    "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
