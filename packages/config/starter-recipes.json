[
  {
    "version": "2.0-push",
    "name": "Trump & Chips News Momentum",
    "description": "Single-stage push prompt combining chip-tariff news, relevant market memories, and technical screening criteria.",
    "cadence": "1d",
    "stages": [
      {
        "id": "stage-1",
        "title": "Catalyst & Technical Analysis",
        "selected_tools": [
          "get_technical_indicators",
          "get_key_metrics",
          "get_price_history",
          "get_todays_news_menu"
        ],
        "blocks": [
          {
            "id": "blk-prompt-1",
            "type": "prompt",
            "text": "Analyze the injected news catalysts and historical memories. Use the tools to verify valuations and technicals."
          },
          {
            "id": "blk-news-1",
            "type": "news",
            "contains": ["Trump", "chips"],
            "recency_hours": 48
          },
          {
            "id": "blk-mem-1",
            "type": "memories",
            "contains": ["tariff", "semiconductor"],
            "recency_hours": 168,
            "category": "MARKET_EVENT",
            "min_importance": 5
          },
          {
            "id": "blk-tech-1",
            "type": "technicals",
            "rules": [
              { "id": "rule-pe", "metric": "P/E", "operator": "<", "target": "45" },
              { "id": "rule-rsi", "metric": "RSI", "operator": "<", "target": "70" }
            ]
          },
          {
            "id": "blk-format-1",
            "type": "output_format"
          }
        ]
      }
    ]
  }
]
